# WORKZO Backend Environment Configuration

PORT=5000
NODE_ENV=development

# Supabase Credentials (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Client Origins for CORS
FRONTEND_URL=http://localhost:5173

# Mobile Number Verification Mode
# 'demo': Instant demo verification with zero carrier SMS requirements (current)
# 'realtime': Live SMS dispatch via Twilio (configure Twilio keys below when ready)
SMS_VERIFICATION_MODE=demo

# Real-Time SMS Gateway (Optional: Configure Twilio to send live carrier SMS to mobile phones)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890
